# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Environment
.venv/
venv/
.env

# Data and model artifacts (keep folder structure via .gitkeep)
data/raw/*
data/processed/*
models/*
!**/.gitkeep

# Demo Clip mode videos: ASL Citizen may not be redistributed. clips.json (names and
# labels only) is versioned; fetch the videos with python -m demo.build_demo_clips.
demo/clips/*
!demo/clips/clips.json

# Generated audio and run logs
demo/tts_samples/
logs/

# Rehearsal logs are your own practice data: keep them locally, out of the repo.
# Remove this line if you want them versioned.
rehearsals/

